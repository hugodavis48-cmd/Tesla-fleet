rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'hugodavis48@gmail.com'
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'email',
          'authProvider',
          'role',
          'referralCode',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'avatar',
          'authProvider',
          'role',
          'referralCode',
          'bio',
          'location',
          'preferredServiceCenter',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.authProvider in ['google.com', 'password'] &&
        data.role == 'customer' &&
        data.referralCode is string && data.referralCode.size() >= 3 && data.referralCode.size() <= 32 &&
        data.referralCode.matches('^[A-Z0-9_\\-]+$') &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
        (!('preferredServiceCenter' in data) || (data.preferredServiceCenter is string && data.preferredServiceCenter.size() <= 160)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Connection health probe document (read-only)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }

    // Owner-isolated user profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (isAdmin() || existing().uid == request.auth.uid);

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().authProvider == existing().authProvider &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'avatar',
          'bio',
          'location',
          'preferredServiceCenter',
          'referralCode',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Read-only admin marker documents
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
