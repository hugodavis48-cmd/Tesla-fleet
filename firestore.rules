rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'emmanuelbrown021@gmail.com' ||
        request.auth.token.email == 'hugodavis48@gmail.com' ||
        request.auth.token.email == 'menge7519@gmail.com'
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'email',
          'authProvider',
          'role',
          'referralCode',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'avatar',
          'authProvider',
          'role',
          'referralCode',
          'bio',
          'location',
          'preferredServiceCenter',
          'themePreference',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.authProvider in ['google.com', 'password'] &&
        data.role == 'customer' &&
        data.referralCode is string && data.referralCode.size() >= 3 && data.referralCode.size() <= 32 &&
        data.referralCode.matches('^[A-Z0-9_\\-]+$') &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
        (!('preferredServiceCenter' in data) || (data.preferredServiceCenter is string && data.preferredServiceCenter.size() <= 160)) &&
        (!('themePreference' in data) || data.themePreference in ['dark', 'light']) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSeoGlobalConfig(data) {
      return data.keys().hasAll([
          'siteTitle',
          'metaDescription',
          'keywords',
          'ogTitle',
          'ogDescription',
          'ogImageUrl',
          'twitterCard',
          'canonicalUrl',
          'logoUrl',
          'faviconUrl',
          'robotsDirective',
          'schemaOrgEnabled',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'siteTitle',
          'metaDescription',
          'keywords',
          'ogTitle',
          'ogDescription',
          'ogImageUrl',
          'twitterCard',
          'canonicalUrl',
          'logoUrl',
          'faviconUrl',
          'robotsDirective',
          'schemaOrgEnabled',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.siteTitle is string && data.siteTitle.size() >= 1 && data.siteTitle.size() <= 200 &&
        data.metaDescription is string && data.metaDescription.size() <= 600 &&
        data.keywords is string && data.keywords.size() <= 600 &&
        data.ogTitle is string && data.ogTitle.size() <= 200 &&
        data.ogDescription is string && data.ogDescription.size() <= 600 &&
        data.ogImageUrl is string && data.ogImageUrl.size() <= 1500 &&
        data.twitterCard in ['summary_large_image', 'summary'] &&
        data.canonicalUrl is string && data.canonicalUrl.size() <= 300 &&
        data.logoUrl is string && data.logoUrl.size() >= 1 && data.logoUrl.size() <= 1500 &&
        data.faviconUrl is string && data.faviconUrl.size() >= 1 && data.faviconUrl.size() <= 1500 &&
        data.robotsDirective is string && data.robotsDirective.size() >= 1 && data.robotsDirective.size() <= 100 &&
        data.schemaOrgEnabled is bool &&
        isValidId(data.updatedByUid) &&
        data.updatedByUid == request.auth.uid &&
        data.updatedAt is timestamp;
    }

    function isValidPageSeoEntry(data) {
      return data.keys().hasAll([
          'pageKey',
          'pageLabel',
          'metaTitle',
          'metaDescription',
          'keywords',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'pageKey',
          'pageLabel',
          'metaTitle',
          'metaDescription',
          'keywords',
          'ogTitle',
          'ogImageUrl',
          'updatedByUid',
          'updatedAt'
        ]) &&
        isValidId(data.pageKey) &&
        data.pageKey.size() <= 64 &&
        data.pageLabel is string && data.pageLabel.size() >= 1 && data.pageLabel.size() <= 120 &&
        data.metaTitle is string && data.metaTitle.size() >= 1 && data.metaTitle.size() <= 200 &&
        data.metaDescription is string && data.metaDescription.size() <= 600 &&
        data.keywords is string && data.keywords.size() <= 600 &&
        (!('ogTitle' in data) || (data.ogTitle is string && data.ogTitle.size() <= 200)) &&
        (!('ogImageUrl' in data) || (data.ogImageUrl is string && data.ogImageUrl.size() <= 1500)) &&
        isValidId(data.updatedByUid) &&
        data.updatedByUid == request.auth.uid &&
        data.updatedAt is timestamp;
    }

    function isValidAdminSettingSection(data) {
      return data.keys().hasAll([
          'sectionId',
          'payloadJson',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sectionId',
          'payloadJson',
          'updatedByUid',
          'updatedAt'
        ]) &&
        isValidId(data.sectionId) &&
        data.sectionId.size() <= 64 &&
        data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 450000 &&
        isValidId(data.updatedByUid) &&
        data.updatedByUid == request.auth.uid &&
        data.updatedAt is timestamp;
    }

    function isPublicConfigSection(sectionId) {
      return sectionId in [
        'site_settings',
        'currencies',
        'feature_toggles',
        'withdrawal_settings',
        'shipping_settings',
        'refund_policy',
        'navigation_menus',
        'site_pages',
        'faqs',
        'sitemap_entries',
        'rss_items',
        'promo_banners',
        'promo_videos',
        'products',
        'tesla_cars',
        'investment_pools',
        'stock_plans',
        'tsla_quote',
        'coupons',
        'wheel_rewards',
        'scratch_tiers',
        'manual_deposits',
        'deposit_gateways',
        'business_certificates',
        'blog_posts',
        'blog_comments',
        'engagement_reward_config',
        'social_links',
        'spin_cost'
      ];
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll([
          'id',
          'role',
          'name',
          'storagePath',
          'downloadUrl',
          'contentType',
          'sizeBytes',
          'uploadedAt',
          'uploadedByUid'
        ]) &&
        data.keys().hasOnly([
          'id',
          'role',
          'name',
          'storagePath',
          'downloadUrl',
          'contentType',
          'sizeBytes',
          'uploadedAt',
          'source',
          'uploadedByUid'
        ]) &&
        isValidId(data.id) &&
        data.role in ['logo', 'favicon', 'og_image', 'general'] &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 500 &&
        data.downloadUrl is string && data.downloadUrl.size() >= 1 && data.downloadUrl.size() <= 1500 &&
        data.contentType is string && data.contentType.size() >= 1 && data.contentType.size() <= 80 &&
        data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 10485760 &&
        data.uploadedAt is string && data.uploadedAt.size() >= 1 && data.uploadedAt.size() <= 64 &&
        (!('source' in data) || data.source in ['firebase_storage', 'local_upload', 'preset']) &&
        isValidId(data.uploadedByUid) &&
        data.uploadedByUid == request.auth.uid;
    }

    // Connection health probe document (read-only)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }

    // Owner-isolated user profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (isAdmin() || existing().uid == request.auth.uid);

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().authProvider == existing().authProvider &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'avatar',
          'bio',
          'location',
          'preferredServiceCenter',
          'referralCode',
          'themePreference',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Read-only admin marker documents
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Global SEO & branding metadata (publicly readable, admin-only write)
    match /site_config/{configId} {
      allow get: if isValidId(configId) && configId == 'seo';
      allow list: if isAdmin();

      allow create, update: if isValidId(configId) &&
        configId == 'seo' &&
        isAdmin() &&
        isValidSeoGlobalConfig(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // Per-page SEO metadata overrides (publicly readable, admin-only write)
    match /page_seo/{pageId} {
      allow get, list: if true;

      allow create, update: if isValidId(pageId) &&
        isAdmin() &&
        isValidPageSeoEntry(incoming()) &&
        incoming().pageKey == pageId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(pageId) && isAdmin();
    }

    // Persisted admin configuration slices (non-secret sections publicly readable by explicit ID; full access for admins)
    match /admin_settings/{sectionId} {
      allow get: if isValidId(sectionId) && (isPublicConfigSection(sectionId) || isAdmin());
      allow list: if isAdmin();

      allow create, update: if isValidId(sectionId) &&
        isAdmin() &&
        isValidAdminSettingSection(incoming()) &&
        incoming().sectionId == sectionId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(sectionId) && isAdmin();
    }

    // Firebase Storage branding media asset metadata registry (zero PII)
    match /media_assets/{assetId} {
      allow get, list: if true;

      allow create, update: if isValidId(assetId) &&
        isAdmin() &&
        isValidMediaAsset(incoming()) &&
        incoming().id == assetId &&
        incoming().uploadedByUid == request.auth.uid;

      allow delete: if isValidId(assetId) && isAdmin();
    }

    function isValidCatalogProduct(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'category',
          'priceUsd',
          'rating',
          'reviewsCount',
          'image',
          'description',
          'compatibility',
          'inStock',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'category',
          'priceUsd',
          'rating',
          'reviewsCount',
          'image',
          'description',
          'compatibility',
          'inStock',
          'updatedByUid',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 180 &&
        data.category in ['Wraps & Film', 'Wheels & Performance', 'Interior & Yoke', 'Aero & Carbon', 'Charging & Tech', 'Vehicle Sales'] &&
        data.priceUsd is number && data.priceUsd >= 0 && data.priceUsd <= 10000000 &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        data.reviewsCount is number && data.reviewsCount >= 0 && data.reviewsCount <= 1000000 &&
        data.image is string && data.image.size() <= 1500 &&
        data.description is string && data.description.size() <= 2000 &&
        data.compatibility is string && data.compatibility.size() <= 300 &&
        data.inStock is bool &&
        isValidId(data.updatedByUid) &&
        data.updatedByUid == request.auth.uid &&
        data.updatedAt is timestamp;
    }

    function isValidMarketingBanner(data) {
      return data.keys().hasAll([
          'id',
          'title',
          'size',
          'dimensions',
          'headline',
          'subheadline',
          'ctaText',
          'badgeText',
          'themeGradient',
          'accentColor',
          'targetTab',
          'imageUrl',
          'isActive',
          'isAiGenerated',
          'is3dHd',
          'style3dPreset',
          'resolutionQuality',
          'carRenderModel',
          'clicksCount',
          'createdAt',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'title',
          'size',
          'dimensions',
          'customWidth',
          'customHeight',
          'imageMode',
          'transitionEffect',
          'headline',
          'subheadline',
          'ctaText',
          'badgeText',
          'themeGradient',
          'accentColor',
          'targetTab',
          'imageUrl',
          'slideImages',
          'slideIntervalSec',
          'isActive',
          'isAiGenerated',
          'is3dHd',
          'style3dPreset',
          'resolutionQuality',
          'carRenderModel',
          'clicksCount',
          'createdAt',
          'updatedByUid',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.size in ['leaderboard', 'square', 'rectangle', 'sidebar', 'billboard', 'wide_skyscraper', 'social_og', 'story', 'mobile_banner', 'custom'] &&
        data.dimensions is string && data.dimensions.size() >= 1 && data.dimensions.size() <= 64 &&
        (!('customWidth' in data) || (data.customWidth is number && data.customWidth >= 50 && data.customWidth <= 8000)) &&
        (!('customHeight' in data) || (data.customHeight is number && data.customHeight >= 50 && data.customHeight <= 8000)) &&
        (!('imageMode' in data) || data.imageMode in ['single', 'multi']) &&
        (!('transitionEffect' in data) || data.transitionEffect in ['fade', 'slide', 'zoom']) &&
        data.headline is string && data.headline.size() >= 1 && data.headline.size() <= 240 &&
        data.subheadline is string && data.subheadline.size() <= 500 &&
        data.ctaText is string && data.ctaText.size() >= 1 && data.ctaText.size() <= 80 &&
        data.badgeText is string && data.badgeText.size() <= 80 &&
        data.themeGradient is string && data.themeGradient.size() <= 200 &&
        data.accentColor is string && data.accentColor.size() >= 1 && data.accentColor.size() <= 40 &&
        data.targetTab is string && data.targetTab.size() >= 1 && data.targetTab.size() <= 64 &&
        data.imageUrl is string && data.imageUrl.size() <= 1500 &&
        (!('slideImages' in data) || (data.slideImages is list && data.slideImages.size() <= 10 && (data.slideImages.size() == 0 || data.slideImages[0] is string))) &&
        (!('slideIntervalSec' in data) || (data.slideIntervalSec is number && data.slideIntervalSec >= 1 && data.slideIntervalSec <= 120)) &&
        data.isActive is bool &&
        data.isAiGenerated is bool &&
        data.is3dHd is bool &&
        data.style3dPreset in ['cyber_perspective', 'holographic_depth', 'studio_4k_bevel', 'obsidian_neon'] &&
        data.resolutionQuality in ['4K UHD', 'HD 1080p'] &&
        data.carRenderModel is string && data.carRenderModel.size() <= 120 &&
        data.clicksCount is number && data.clicksCount >= 0 &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        isValidId(data.updatedByUid) &&
        data.updatedByUid == request.auth.uid &&
        data.updatedAt is timestamp;
    }

    function isValidManagedUser(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'email',
          'role',
          'tier',
          'accountStatus',
          'kycStatus',
          'totalDepositedUsd',
          'referralCount',
          'referralEarningsUsd',
          'referralCode',
          'location',
          'phone',
          'bio',
          'preferredServiceCenter',
          'avatar',
          'memberSince',
          'walletAddress',
          'twoFactorEnabled',
          'updatedByUid',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'email',
          'role',
          'tier',
          'accountStatus',
          'kycStatus',
          'totalDepositedUsd',
          'referralCount',
          'referralEarningsUsd',
          'referralCode',
          'location',
          'phone',
          'bio',
          'preferredServiceCenter',
          'avatar',
          'memberSince',
          'walletAddress',
          'twoFactorEnabled',
          'updatedByUid',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role in ['customer', 'admin'] &&
        data.tier in ['Standard', 'Silver Ambassador', 'Plaid Member', 'Founders Club'] &&
        data.accountStatus in ['active', 'suspended', 'flagged', 'banned'] &&
        data.kycStatus in ['unverified', 'in_review', 'verified', 'rejected'] &&
        data.totalDepositedUsd is number && data.totalDepositedUsd >= 0 && data.totalDepositedUsd <= 100000000 &&
        data.referralCount is number && data.referralCount >= 0 && data.referralCount <= 1000000 &&
        data.referralEarningsUsd is number && data.referralEarningsUsd >= 0 && data.referralEarningsUsd <= 100000000 &&
        data.referralCode is string && data.referralCode.size() >= 2 && data.referralCode.size() <= 32 &&
        data.location is string && data.location.size() <= 120 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.bio is string && data.bio.size() <= 500 &&
        data.preferredServiceCenter is string && data.preferredServiceCenter.size() <= 160 &&
        data.avatar is string && data.avatar.size() <= 500 &&
        data.memberSince is string && data.memberSince.size() >= 1 && data.memberSince.size() <= 64 &&
        data.walletAddress is string && data.walletAddress.size() <= 128 &&
        data.twoFactorEnabled is bool &&
        isValidId(data.updatedByUid) &&
        data.updatedByUid == request.auth.uid &&
        data.updatedAt is timestamp;
    }

    // Store product inventory (public catalog read, admin-only CRUD)
    match /products/{productId} {
      allow get, list: if true;

      allow create, update: if isValidId(productId) &&
        isAdmin() &&
        isValidCatalogProduct(incoming()) &&
        incoming().id == productId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(productId) && isAdmin();
    }

    // Promotional marketing banners (public showcase read, admin-only CRUD)
    match /marketing_banners/{bannerId} {
      allow get, list: if true;

      allow create, update: if isValidId(bannerId) &&
        isAdmin() &&
        isValidMarketingBanner(incoming()) &&
        incoming().id == bannerId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(bannerId) && isAdmin();
    }

    // Admin-managed user directory records (strict admin-only PII isolation)
    match /managed_users/{userId} {
      allow get: if isValidId(userId) && isAdmin();
      allow list: if isAdmin();

      allow create, update: if isValidId(userId) &&
        isAdmin() &&
        isValidManagedUser(incoming()) &&
        incoming().id == userId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(userId) && isAdmin();
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasAll([
          'id',
          'email',
          'interestCategory',
          'status',
          'source',
          'subscribedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'email',
          'name',
          'interestCategory',
          'status',
          'source',
          'subscribedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
        data.interestCategory in ['All Updates', 'Service & Wraps', 'Fleet & Yield', 'Vehicle Drops & Promos'] &&
        data.status in ['active', 'unsubscribed'] &&
        data.source in ['home_banner', 'footer', 'admin_manual', 'registered_sync'] &&
        data.subscribedAt is string && data.subscribedAt.size() >= 1 && data.subscribedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Newsletter mailing list subscribers (strict admin-only PII read/manage; validated public opt-in create)
    match /newsletter_subscribers/{subscriberId} {
      allow get: if isValidId(subscriberId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(subscriberId) &&
        isValidNewsletterSubscriber(incoming()) &&
        incoming().id == subscriberId &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(subscriberId) &&
        isAdmin() &&
        isValidNewsletterSubscriber(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'interestCategory',
          'status',
          'updatedAt'
        ]);

      allow delete: if isValidId(subscriberId) && isAdmin();
    }

    function isValidEngagementActivity(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'userTier',
          'activityType',
          'pageTab',
          'centsEarned',
          'pointsEarned',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'userId',
          'userTier',
          'activityType',
          'pageTab',
          'dwellSeconds',
          'platform',
          'targetTitle',
          'centsEarned',
          'pointsEarned',
          'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.userTier is string && data.userTier.size() >= 1 && data.userTier.size() <= 64 &&
        data.activityType in ['page_dwell', 'social_share'] &&
        isValidId(data.pageTab) && data.pageTab.size() <= 64 &&
        (!('dwellSeconds' in data) || (data.dwellSeconds is number && data.dwellSeconds >= 0 && data.dwellSeconds <= 86400)) &&
        (!('platform' in data) || (data.platform is string && data.platform.size() <= 40)) &&
        (!('targetTitle' in data) || (data.targetTitle is string && data.targetTitle.size() <= 200)) &&
        data.centsEarned is number && data.centsEarned >= 0 && data.centsEarned <= 10000 &&
        data.pointsEarned is number && data.pointsEarned >= 0 && data.pointsEarned <= 100000 &&
        data.createdAt is timestamp;
    }

    // Logged-in user dwell time & social sharing activity tracker (owner-isolated & immutable)
    match /engagement_activities/{activityId} {
      allow get: if isValidId(activityId) && isVerifiedUser() && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isVerifiedUser() && (isAdmin() || existing().userId == request.auth.uid);

      allow create: if isValidId(activityId) &&
        isVerifiedUser() &&
        isValidEngagementActivity(incoming()) &&
        incoming().id == activityId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(activityId) && isAdmin();
    }
  }
}
