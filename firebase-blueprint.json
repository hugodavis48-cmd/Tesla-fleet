{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile synchronized from Google Social Sign-Up or Apex Tesla Hub authentication.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the customer.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address.",
          "minLength": 3,
          "maxLength": 200
        },
        "avatar": {
          "type": "string",
          "description": "Profile avatar URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "authProvider": {
          "type": "string",
          "description": "Authentication provider identifier.",
          "enum": ["google.com", "password"]
        },
        "role": {
          "type": "string",
          "description": "User role fixed to customer for client registrations.",
          "enum": ["customer"]
        },
        "referralCode": {
          "type": "string",
          "description": "Unique referral code assigned to the customer.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "bio": {
          "type": "string",
          "description": "Short owner biography.",
          "minLength": 0,
          "maxLength": 500
        },
        "location": {
          "type": "string",
          "description": "City or regional hub.",
          "minLength": 0,
          "maxLength": 120
        },
        "preferredServiceCenter": {
          "type": "string",
          "description": "Preferred Apex Tesla service center.",
          "minLength": 0,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last profile update."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "authProvider",
        "role",
        "referralCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-provisioned administrator marker document for RBAC verification.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email.",
          "minLength": 3,
          "maxLength": 200
        },
        "adminRoleLabel": {
          "type": "string",
          "description": "Administrator title.",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": ["uid", "email", "adminRoleLabel"]
    },
    "SeoGlobalConfig": {
      "title": "SeoGlobalConfig",
      "description": "Global site branding, logo/favicon URLs, and fallback SEO metadata.",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "metaDescription": { "type": "string", "minLength": 0, "maxLength": 600 },
        "keywords": { "type": "string", "minLength": 0, "maxLength": 600 },
        "ogTitle": { "type": "string", "minLength": 0, "maxLength": 200 },
        "ogDescription": { "type": "string", "minLength": 0, "maxLength": 600 },
        "ogImageUrl": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "twitterCard": { "type": "string", "enum": ["summary_large_image", "summary"] },
        "canonicalUrl": { "type": "string", "minLength": 0, "maxLength": 300 },
        "logoUrl": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "faviconUrl": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "robotsDirective": { "type": "string", "minLength": 1, "maxLength": 100 },
        "schemaOrgEnabled": { "type": "boolean" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "siteTitle",
        "metaDescription",
        "keywords",
        "ogTitle",
        "ogDescription",
        "ogImageUrl",
        "twitterCard",
        "canonicalUrl",
        "logoUrl",
        "faviconUrl",
        "robotsDirective",
        "schemaOrgEnabled",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "PageSeoEntry": {
      "title": "PageSeoEntry",
      "description": "Per-page dynamic SEO title, description, keywords, and OpenGraph overrides.",
      "type": "object",
      "properties": {
        "pageKey": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pageLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "metaTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "metaDescription": { "type": "string", "minLength": 0, "maxLength": 600 },
        "keywords": { "type": "string", "minLength": 0, "maxLength": 600 },
        "ogTitle": { "type": "string", "minLength": 0, "maxLength": 200 },
        "ogImageUrl": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pageKey", "pageLabel", "metaTitle", "metaDescription", "keywords", "updatedByUid", "updatedAt"]
    },
    "AdminSettingSection": {
      "title": "AdminSettingSection",
      "description": "Persisted admin-managed platform configuration slice stored cleanly by section ID.",
      "type": "object",
      "properties": {
        "sectionId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "payloadJson": { "type": "string", "minLength": 2, "maxLength": 450000 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sectionId", "payloadJson", "updatedByUid", "updatedAt"]
    },
    "MediaAssetRecord": {
      "title": "MediaAssetRecord",
      "description": "Firebase Storage branding and media asset metadata record (logo, favicon, OG image).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["logo", "favicon", "og_image", "general"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "storagePath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "downloadUrl": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "contentType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sizeBytes": { "type": "number" },
        "uploadedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source": { "type": "string", "enum": ["firebase_storage", "local_upload", "preset"] },
        "uploadedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": ["id", "role", "name", "storagePath", "downloadUrl", "contentType", "sizeBytes", "uploadedAt", "uploadedByUid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated customer profile documents synced on Google Social Sign-Up."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Read-only administrator allowlist markers managed by backend/super-admin."
    },
    "/site_config/{configId}": {
      "schema": { "$ref": "#/entities/SeoGlobalConfig" },
      "description": "Global site branding & fallback SEO configuration (doc ID: seo)."
    },
    "/page_seo/{pageId}": {
      "schema": { "$ref": "#/entities/PageSeoEntry" },
      "description": "Per-page dynamic meta title, description, and keyword overrides."
    },
    "/admin_settings/{sectionId}": {
      "schema": { "$ref": "#/entities/AdminSettingSection" },
      "description": "All admin-saved platform settings slices (currencies, toggles, menus, FAQs, inventory, etc.)."
    },
    "/media_assets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAssetRecord" },
      "description": "Metadata registry for Firebase Storage branding uploads (logo, favicon, OG images)."
    }
  }
}
