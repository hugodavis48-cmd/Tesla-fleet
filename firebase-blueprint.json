{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile synchronized from Google Social Sign-Up or Apex Tesla Hub authentication.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the customer.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address.",
          "minLength": 3,
          "maxLength": 200
        },
        "avatar": {
          "type": "string",
          "description": "Profile avatar URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "authProvider": {
          "type": "string",
          "description": "Authentication provider identifier.",
          "enum": ["google.com", "password"]
        },
        "role": {
          "type": "string",
          "description": "User role fixed to customer for client registrations.",
          "enum": ["customer"]
        },
        "referralCode": {
          "type": "string",
          "description": "Unique referral code assigned to the customer.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "bio": {
          "type": "string",
          "description": "Short owner biography.",
          "minLength": 0,
          "maxLength": 500
        },
        "location": {
          "type": "string",
          "description": "City or regional hub.",
          "minLength": 0,
          "maxLength": 120
        },
        "preferredServiceCenter": {
          "type": "string",
          "description": "Preferred Apex Tesla service center.",
          "minLength": 0,
          "maxLength": 160
        },
        "themePreference": {
          "type": "string",
          "description": "Persisted light or dark UI theme preference synced across sessions.",
          "enum": ["dark", "light"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last profile update."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "authProvider",
        "role",
        "referralCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-provisioned administrator marker document for RBAC verification.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email.",
          "minLength": 3,
          "maxLength": 200
        },
        "adminRoleLabel": {
          "type": "string",
          "description": "Administrator title.",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": ["uid", "email", "adminRoleLabel"]
    },
    "SeoGlobalConfig": {
      "title": "SeoGlobalConfig",
      "description": "Global site branding, logo/favicon URLs, and fallback SEO metadata.",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "metaDescription": { "type": "string", "minLength": 0, "maxLength": 600 },
        "keywords": { "type": "string", "minLength": 0, "maxLength": 600 },
        "ogTitle": { "type": "string", "minLength": 0, "maxLength": 200 },
        "ogDescription": { "type": "string", "minLength": 0, "maxLength": 600 },
        "ogImageUrl": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "twitterCard": { "type": "string", "enum": ["summary_large_image", "summary"] },
        "canonicalUrl": { "type": "string", "minLength": 0, "maxLength": 300 },
        "logoUrl": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "faviconUrl": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "robotsDirective": { "type": "string", "minLength": 1, "maxLength": 100 },
        "schemaOrgEnabled": { "type": "boolean" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "siteTitle",
        "metaDescription",
        "keywords",
        "ogTitle",
        "ogDescription",
        "ogImageUrl",
        "twitterCard",
        "canonicalUrl",
        "logoUrl",
        "faviconUrl",
        "robotsDirective",
        "schemaOrgEnabled",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "PageSeoEntry": {
      "title": "PageSeoEntry",
      "description": "Per-page dynamic SEO title, description, keywords, and OpenGraph overrides.",
      "type": "object",
      "properties": {
        "pageKey": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pageLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "metaTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "metaDescription": { "type": "string", "minLength": 0, "maxLength": 600 },
        "keywords": { "type": "string", "minLength": 0, "maxLength": 600 },
        "ogTitle": { "type": "string", "minLength": 0, "maxLength": 200 },
        "ogImageUrl": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pageKey", "pageLabel", "metaTitle", "metaDescription", "keywords", "updatedByUid", "updatedAt"]
    },
    "AdminSettingSection": {
      "title": "AdminSettingSection",
      "description": "Persisted admin-managed platform configuration slice stored cleanly by section ID.",
      "type": "object",
      "properties": {
        "sectionId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "payloadJson": { "type": "string", "minLength": 2, "maxLength": 450000 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sectionId", "payloadJson", "updatedByUid", "updatedAt"]
    },
    "MediaAssetRecord": {
      "title": "MediaAssetRecord",
      "description": "Firebase Storage branding and media asset metadata record (logo, favicon, OG image).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["logo", "favicon", "og_image", "general"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "storagePath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "downloadUrl": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "contentType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sizeBytes": { "type": "number" },
        "uploadedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source": { "type": "string", "enum": ["firebase_storage", "local_upload", "preset"] },
        "uploadedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": ["id", "role", "name", "storagePath", "downloadUrl", "contentType", "sizeBytes", "uploadedAt", "uploadedByUid"]
    },
    "CatalogProduct": {
      "title": "CatalogProduct",
      "description": "Storefront hardware, wrap, wheel, or tech catalog item managed by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "category": { "type": "string", "enum": ["Wraps & Film", "Wheels & Performance", "Interior & Yoke", "Aero & Carbon", "Charging & Tech", "Vehicle Sales"] },
        "priceUsd": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "image": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "description": { "type": "string", "minLength": 0, "maxLength": 2000 },
        "compatibility": { "type": "string", "minLength": 0, "maxLength": 300 },
        "inStock": { "type": "boolean" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "priceUsd", "rating", "reviewsCount", "image", "description", "compatibility", "inStock", "updatedByUid", "updatedAt"]
    },
    "PromotionalBanner": {
      "title": "PromotionalBanner",
      "description": "Admin-managed 3D/HD promotional marketing banner persisted in Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "size": { "type": "string", "enum": ["leaderboard", "square", "rectangle", "sidebar", "billboard", "wide_skyscraper", "social_og", "story", "mobile_banner", "custom"] },
        "dimensions": { "type": "string", "minLength": 1, "maxLength": 64 },
        "customWidth": { "type": "number" },
        "customHeight": { "type": "number" },
        "imageMode": { "type": "string", "enum": ["single", "multi"] },
        "transitionEffect": { "type": "string", "enum": ["fade", "slide", "zoom"] },
        "headline": { "type": "string", "minLength": 1, "maxLength": 240 },
        "subheadline": { "type": "string", "minLength": 0, "maxLength": 500 },
        "ctaText": { "type": "string", "minLength": 1, "maxLength": 80 },
        "badgeText": { "type": "string", "minLength": 0, "maxLength": 80 },
        "themeGradient": { "type": "string", "minLength": 0, "maxLength": 200 },
        "accentColor": { "type": "string", "minLength": 1, "maxLength": 40 },
        "targetTab": { "type": "string", "minLength": 1, "maxLength": 64 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "slideImages": { "type": "array" },
        "slideIntervalSec": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isAiGenerated": { "type": "boolean" },
        "is3dHd": { "type": "boolean" },
        "style3dPreset": { "type": "string", "enum": ["cyber_perspective", "holographic_depth", "studio_4k_bevel", "obsidian_neon"] },
        "resolutionQuality": { "type": "string", "enum": ["4K UHD", "HD 1080p"] },
        "carRenderModel": { "type": "string", "minLength": 0, "maxLength": 120 },
        "clicksCount": { "type": "number" },
        "createdAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "size", "dimensions", "headline", "subheadline", "ctaText", "badgeText", "themeGradient", "accentColor", "targetTab", "imageUrl", "isActive", "isAiGenerated", "is3dHd", "style3dPreset", "resolutionQuality", "carRenderModel", "clicksCount", "createdAt", "updatedByUid", "updatedAt"]
    },
    "ManagedUserRecord": {
      "title": "ManagedUserRecord",
      "description": "Admin-managed directory record for user accounts, tiers, cumulative deposits, and KYC status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 200 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "tier": { "type": "string", "enum": ["Standard", "Plaid Member", "Founders Club"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended", "flagged", "banned"] },
        "kycStatus": { "type": "string", "enum": ["unverified", "in_review", "verified", "rejected"] },
        "totalDepositedUsd": { "type": "number" },
        "referralCount": { "type": "number" },
        "referralEarningsUsd": { "type": "number" },
        "referralCode": { "type": "string", "minLength": 2, "maxLength": 32 },
        "location": { "type": "string", "minLength": 0, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 40 },
        "bio": { "type": "string", "minLength": 0, "maxLength": 500 },
        "preferredServiceCenter": { "type": "string", "minLength": 0, "maxLength": 160 },
        "avatar": { "type": "string", "minLength": 0, "maxLength": 500 },
        "memberSince": { "type": "string", "minLength": 1, "maxLength": 64 },
        "walletAddress": { "type": "string", "minLength": 0, "maxLength": 128 },
        "twoFactorEnabled": { "type": "boolean" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "tier", "accountStatus", "kycStatus", "totalDepositedUsd", "referralCount", "referralEarningsUsd", "referralCode", "location", "phone", "bio", "preferredServiceCenter", "avatar", "memberSince", "walletAddress", "twoFactorEnabled", "updatedByUid", "updatedAt"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Email mailing list subscriber persisted in Firestore for bulk updates and announcements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 200 },
        "name": { "type": "string", "minLength": 0, "maxLength": 120 },
        "interestCategory": {
          "type": "string",
          "enum": ["All Updates", "Service & Wraps", "Fleet & Yield", "Vehicle Drops & Promos"]
        },
        "status": { "type": "string", "enum": ["active", "unsubscribed"] },
        "source": { "type": "string", "enum": ["home_banner", "footer", "admin_manual", "registered_sync"] },
        "subscribedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "interestCategory", "status", "source", "subscribedAt", "createdAt", "updatedAt"]
    },
    "EngagementActivity": {
      "title": "EngagementActivity",
      "description": "Lightweight logged-in user activity record tracking page dwell time, social sharing interactions, and earned engagement points/cents.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userTier": { "type": "string", "minLength": 1, "maxLength": 64 },
        "activityType": { "type": "string", "enum": ["page_dwell", "social_share"] },
        "pageTab": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dwellSeconds": { "type": "number" },
        "platform": { "type": "string", "minLength": 0, "maxLength": 40 },
        "targetTitle": { "type": "string", "minLength": 0, "maxLength": 200 },
        "centsEarned": { "type": "number" },
        "pointsEarned": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userTier", "activityType", "pageTab", "centsEarned", "pointsEarned", "createdAt"]
    },
    "DepositRecord": {
      "title": "DepositRecord",
      "description": "Verified deposit ledger record used to cross-reference spin, scratch, and shipping payments.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "currency": { "type": "string", "minLength": 2, "maxLength": 16 },
        "amount": { "type": "number" },
        "usdEquivalent": { "type": "number" },
        "remainingUsd": { "type": "number" },
        "txHash": { "type": "string", "minLength": 6, "maxLength": 160 },
        "gatewayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source": {
          "type": "string",
          "enum": ["seed_vault", "gateway_deposit", "manual_approved", "investment_maturity", "admin_deposit_credit"]
        },
        "status": { "type": "string", "enum": ["verified", "revoked"] },
        "signature": { "type": "string", "minLength": 16, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "currency", "amount", "usdEquivalent", "remainingUsd", "txHash", "gatewayName", "source", "status", "signature", "createdAt"]
    },
    "TransactionValidationAudit": {
      "title": "TransactionValidationAudit",
      "description": "Immutable server validation audit entry recording cross-referenced deposit checks and anti-manipulation rejections.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": {
          "type": "string",
          "enum": ["spin_payment", "scratch_purchase", "won_vehicle_shipping", "vehicle_order_shipping", "deposit_record", "admin_adjust", "security_rejection"]
        },
        "amountUsd": { "type": "number" },
        "depositConsumedUsd": { "type": "number" },
        "freeWinConsumedUsd": { "type": "number" },
        "outcome": { "type": "string", "enum": ["approved", "rejected"] },
        "rejectionCode": { "type": "string", "minLength": 0, "maxLength": 80 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "signature": { "type": "string", "minLength": 16, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "category", "amountUsd", "depositConsumedUsd", "freeWinConsumedUsd", "outcome", "reason", "signature", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated customer profile documents synced on Google Social Sign-Up."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Read-only administrator allowlist markers managed by backend/super-admin."
    },
    "/site_config/{configId}": {
      "schema": { "$ref": "#/entities/SeoGlobalConfig" },
      "description": "Global site branding & fallback SEO configuration (doc ID: seo)."
    },
    "/page_seo/{pageId}": {
      "schema": { "$ref": "#/entities/PageSeoEntry" },
      "description": "Per-page dynamic meta title, description, and keyword overrides."
    },
    "/admin_settings/{sectionId}": {
      "schema": { "$ref": "#/entities/AdminSettingSection" },
      "description": "All admin-saved platform settings slices (currencies, toggles, menus, FAQs, inventory, etc.)."
    },
    "/media_assets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAssetRecord" },
      "description": "Metadata registry for Firebase Storage branding uploads (logo, favicon, OG images)."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/CatalogProduct" },
      "description": "Publicly readable Tesla parts, wraps, and accessories inventory managed by admins."
    },
    "/marketing_banners/{bannerId}": {
      "schema": { "$ref": "#/entities/PromotionalBanner" },
      "description": "Publicly readable 3D/HD promotional banners managed by admins."
    },
    "/managed_users/{userId}": {
      "schema": { "$ref": "#/entities/ManagedUserRecord" },
      "description": "Admin-isolated directory records for full User Management CRUD persistence."
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Admin-isolated mailing list subscribers collected via NewsletterSignup."
    },
    "/engagement_activities/{activityId}": {
      "schema": { "$ref": "#/entities/EngagementActivity" },
      "description": "Owner-isolated user engagement activity telemetry (page dwell time & social share interactions) for cent rewards."
    },
    "/deposit_records/{recordId}": {
      "schema": { "$ref": "#/entities/DepositRecord" },
      "description": "Admin/server-minted verified deposit records cross-referenced before spin, scratch, or shipping settlements."
    },
    "/transaction_audits/{auditId}": {
      "schema": { "$ref": "#/entities/TransactionValidationAudit" },
      "description": "Immutable transaction validation & anti-manipulation audit log."
    }
  }
}
